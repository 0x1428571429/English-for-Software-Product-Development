{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blurt",
  "version": "1.0.1",
  "identifier": "com.reflexenglish.trainer",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "脱口 — 工程师工作英语训练",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "用真实工作场景训练英语的下意识反应",
    "longDescription": "把 22 个软件研发工作场景变成限时反射训练、场景选择、对话角色扮演、听力与打字练习，并用间隔重复和反应时间统计训练脱口而出。",
    "category": "Education",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
